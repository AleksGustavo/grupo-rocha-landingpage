# ── Formulário de contato (Resend) ────────────────────────────────
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=

# Remetente verificado no Resend (ex.: "Grupo Rocha <contato@seudominio.com.br>").
# Enquanto o domínio não estiver verificado, use "onboarding@resend.dev".
CONTACT_FROM_EMAIL="Grupo Rocha <onboarding@resend.dev>"

# Para onde as mensagens do formulário são enviadas.
# Se vazio, usa o e-mail definido em content/empresa.ts.
CONTACT_TO_EMAIL=
